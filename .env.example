# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env

# Kakao Local API REST 키. picdot 수집과 주소 보강에 쓴다.
# Kakao Developers 에서 앱 > 플랫폼 키 > REST API 키를 발급받는다.
KAKAO_API_KEY=

# 로컬 개발은 저장소가 들고 있는 프로파일을 쓴다. neki-local 은 LocalStack 을
# 가리키므로 실제 AWS 로 나가지 않는다. 경로가 상대경로이므로 저장소 루트에서
# 실행해야 한다.
#
# 운영 파드는 이 두 값을 설정하지 않는다. k8s Secret 이 AWS_ACCESS_KEY_ID 등을
# 환경변수로 넣어 boto3 기본 자격증명 체인이 집어간다.
AWS_CONFIG_FILE=aws/config
AWS_PROFILE=neki-local

# 적재 대상 버킷. 로컬은 make s3-init 이 만들어준다.
S3_BUCKET=team-neki-workflow-local

# LocalStack 표준 포트는 4566 이다. 다른 프로젝트가 이미 쓰고 있으면 아래 둘을
# 같이 옮긴다. 포트가 겹치지 않으면 두 줄 모두 지워도 된다.
#
# AWS_ENDPOINT_URL 은 aws/config 의 endpoint_url 보다 우선한다.
LOCALSTACK_PORT=4576
AWS_ENDPOINT_URL=http://localhost:4576

# 적재할 Postgres. 법정동/지하철 역 테이블과 지점 수집의 적재 위치
# (tb_store_collect_manifest) 가 여기로 간다. 수집 flow 도 이 값이 있어야 돈다.
# 로컬은 Team-Neki-Server 의 local 프로파일과 같은 DB 를 가리킨다. 운영은 GitOps 의
# k8s Secret prefect-workflow 가 flow run Job 파드 환경변수로 넣는다
# (worker 파드가 아니다).
DATABASE_URL=postgresql://admin:admin1234@localhost:5432/yapp

# enrich 가 끝나면 띄우는 서버 batch 이미지 (ghcr.io/team-neki/neki-batch:<tag>).
# 운영은 GitOps 의 neki-images ConfigMap 이 flow run 파드에 넣는다. 비우면 색인
# Job 을 띄우지 않고 경고만 남긴다. 로컬은 k8s 가 없으므로 비워 둔다.
NEKI_BATCH_IMAGE=
